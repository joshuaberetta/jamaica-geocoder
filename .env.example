# Google Maps API Key (REQUIRED)
# Get your key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your-api-key-here

# Bootstrap admin user (Django). On startup the entrypoint creates/updates this
# superuser and mints an API token for it. Used for batch geocoding + cache clear.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-this-password
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Django settings
SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=false
ALLOWED_HOSTS=*
# CORS_ALLOWED_ORIGINS=http://localhost:5173   # only needed for the Vite dev server

# Optional: Redis for cross-worker caching (required if WORKERS > 1)
# REDIS_URL=redis://localhost:6379/0

# Optional: admin API token for scripts/ingest.py to clear the cache after ingest
# (otherwise it falls back to APP_LOGIN_USERNAME/PASSWORD -> /api/token)
# APP_API_TOKEN=
# APP_URL=http://localhost:8000

# PostgreSQL password — used by docker-compose and DATABASE_URL
POSTGRES_PASSWORD=change-me

# Database connection string.
# When running via docker compose: value is set automatically in docker-compose.yml
# When running web_app.py directly against the Docker DB on localhost:
DATABASE_URL=postgresql://geocode:change-me@localhost:5432/geocode
